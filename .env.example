APP_NAME=JobAgent
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Production (PostgreSQL): set DB_CONNECTION=pgsql and either DATABASE_URL
# or the separate variables below. On Railway, use reference variables from
# the Postgres service, e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAILTARGET_API_KEY=
MAILTARGET_ENDPOINT=https://transmission.mailtarget.co/v1/layang/transmissions
MAIL_FROM_ADDRESS=default@sandbox.mailtarget.co
MAIL_FROM_NAME=JobAgent

FIREBASE_PROJECT_ID=jobsagent-f4fda
FIREBASE_API_KEY=AIzaSyCRUA_niZVLyYEs-9-3QlMiPjcttVyx4gE
FIREBASE_AUTH_DOMAIN=jobsagent-f4fda.firebaseapp.com
FIREBASE_STORAGE_BUCKET=jobsagent-f4fda.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=493405453619
FIREBASE_APP_ID=1:493405453619:web:5d3246fbe7335764529246
FIREBASE_MEASUREMENT_ID=G-DT2X00ZV2M
# REQUIRED in production: full service account JSON, set as an environment
# variable only. Never commit real keys or credentials to the repository.
FIREBASE_SERVICE_ACCOUNT_JSON=
OTP_SECRET=

# NOTE: FIREBASE_*, MAILTARGET_API_KEY, OTP_SECRET, APP_KEY and database
# credentials are sensitive and must be provided as environment variables
# (e.g. in the Railway dashboard), not stored in files. See .env.production.
